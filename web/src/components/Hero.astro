---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

// Los ficheros de public/ no llevan el `base` puesto: hay que prefijarlos.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * Bucle de fondo de la portada.
 *
 * Los ficheros de `public/portada/` los genera `npm run portada` a partir del
 * original del cliente en `assets/portada.mp4`: quita el audio, cierra el bucle
 * con un fundido cruzado y saca el MP4, el WebM y el póster. Para cambiar el
 * vídeo, sustituye el original y vuelve a lanzarlo.
 */
const video = 'portada';
---

<section class="hero">
  <div class="hero-bg">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={`${base}/portada/${video}.jpg`}
      aria-hidden="true"
      tabindex="-1"
      data-hero-video
    >
      <source src={`${base}/portada/${video}.webm`} type="video/webm" />
      <source src={`${base}/portada/${video}.mp4`} type="video/mp4" />
    </video>
  </div>
  <div class="hero-veil"></div>

  <p class="hero-kicker">Calzone · Pizzas · Roscas</p>

  <div class="hero-logo">
    <Image
      src={logo}
      alt="Pizza José Villegas"
      widths={[330, 660, 990]}
      sizes="min(80vw, 330px)"
      format="webp"
      quality={85}
      fetchpriority="high"
    />
  </div>

  <div class="hero-cta">
    <p>Descubre nuestra carta</p>
    <svg class="hero-arrow" width="26" height="74" viewBox="0 0 26 74" fill="none" aria-hidden="true">
      <path d="M13 74 L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path
        d="M3 15 L13 3 L23 15"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</section>
